{
  "name": "osint-mapper",
  "private": true,
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node dist/main.js",
    "dev": "tsx src/server/main.ts",
    "launch": "node dist/launch.js",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"static/*.{html,css}\" \"*.json\""
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "version": "4.0.0",
  "description": "Local TypeScript investigation workspace",
  "engines": {
    "node": ">=24.0.0"
  }
}
